model Session {
  id           String              @id @default(uuid())
  session      SessionBucketType
  sessionValue String
  sessionLevel String              @unique
  year         String
  creationMode SessionCreationMode @default(Manual)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  events       Event[]             @relation("EventCatalogSession")

  @@index([year])
  @@map("sessions")
}

model Event {
  id                      String            @id @default(uuid())
  baseEventName           String?
  eventName               String
  eventYear               String?
  scheduleLabel           String?           @map("eventSessionLabel")
  coverImage              String
  programId               String
  organizer               String
  location                String?
  eventPortal             String
  registrationPortal      String
  description             String
  note                    String?
  creationMode            EventCreationMode @default(Manual)
  sourceEventId           String?
  sessionId               String?
  isSharedToCommunity     Boolean           @default(false)
  isUserAgreementAccepted Boolean           @default(false)
  version                 Int               @default(1)
  creatorId               String
  lastEditorId            String?
  isPublished             Boolean           @default(true)
  isActive                Boolean           @default(true)
  isVerified              Boolean           @default(false)
  isDisabled              Boolean           @default(false)
  isDeleted               Boolean           @default(false)
  deletedAt               DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  editLogs                EditLog[]
  eventApplieds           EventApplied[]
  groups                  EventGroup[]
  invitations             EventInvitation[]
  results                 EventResult[]
  schedule                EventSchedule?
  creator                 User              @relation("EventCreator", fields: [creatorId], references: [id])
  lastEditor              User?             @relation("EventLastEditor", fields: [lastEditorId], references: [id])
  program                 Program           @relation(fields: [programId], references: [id])
  catalogSession          Session?          @relation("EventCatalogSession", fields: [sessionId], references: [id], onDelete: Restrict)
  sourceEvent             Event?            @relation("EventAutoSource", fields: [sourceEventId], references: [id])
  generatedEvents         Event[]           @relation("EventAutoSource")
  repeatConfig            RepeatConfig?

  @@index([programId])
  @@index([eventName])
  @@index([creatorId])
  @@index([lastEditorId])
  @@index([creationMode])
  @@index([sourceEventId])
  @@index([sessionId])
  @@index([isDisabled])
  @@map("events")
}

/// Per-event registration window and pricing only. Catalog `Session` lives on `Event.sessionId`.
model EventSchedule {
  id               String           @id @default(uuid())
  eventId          String           @unique
  competitionLevel CompetitionLevel
  eventType        EventType
  registrationDate DateTime
  deadline         DateTime
  cost             Decimal          @db.Decimal(10, 2)
  hasFinalDeadline Boolean          @default(false)
  finalDeadline    DateTime?
  lateFee          Decimal          @default(0) @db.Decimal(10, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_schedules")
}

model EventGroup {
  id        String         @id @default(uuid())
  eventId   String
  name      String
  criteria  GroupCriteria
  condition RoundCondition
  value     Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rounds    EventRound[]

  @@index([eventId])
  @@map("event_groups")
}

model EventRound {
  id               String           @id @default(uuid())
  groupId          String
  roundType        CompetitionLevel
  deadline         DateTime
  cost             Decimal          @db.Decimal(10, 2)
  hasFinalDeadline Boolean          @default(false)
  finalDeadline    DateTime?
  lateFee          Decimal          @default(0) @db.Decimal(10, 2)
  description      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  group            EventGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("event_rounds")
}

model RepeatConfig {
  id                   String          @id @default(uuid())
  eventId              String          @unique
  frequency            RepeatFrequency @default(DontRepeat)
  startDate            DateTime?
  nextAutoGenerateDate DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  event                Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("repeat_configs")
}

model EventResult {
  id        String        @id @default(uuid())
  eventId   String
  placement PlacementType
  note      String?
  createdAt DateTime      @default(now())
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, placement])
  @@map("event_results")
}

model EditLog {
  id             String   @id @default(uuid())
  eventId        String
  version        Int
  editorId       String
  changedFields  String[]
  previousValues Json
  createdAt      DateTime @default(now())
  editor         User     @relation(fields: [editorId], references: [id])
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([createdAt])
  @@index([editorId])
  @@map("edit_logs")
}
